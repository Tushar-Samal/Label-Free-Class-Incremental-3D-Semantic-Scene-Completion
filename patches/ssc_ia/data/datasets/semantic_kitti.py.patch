+    def _apply_disjoint_cil(self, target_global: np.ndarray):
+        splits = self._splits_to_list(self.continual_splits)
+        seen, cur = self._build_seen_new_classes(splits, self.continual_step)
+
+        cur_set  = set(cur)
+        seen_set = set(seen)
+        old_set  = seen_set - cur_set
+
+        y = target_global.copy()
+
+        is_empty  = (y == self.empty_label)
+        is_cur    = np.isin(y, list(cur_set))
+        is_old    = np.isin(y, list(old_set))
+        is_seen   = np.isin(y, list(seen_set))
+        is_future = (~is_empty) & (~is_seen)
+
+        y_disjoint = y.copy()
+        y_disjoint[is_old]   = self.empty_label
+        y_disjoint[is_future] = self.ignore_index
+
+        y_cur_compact = np.full_like(y_disjoint, fill_value=self.ignore_index)
+        y_cur_compact[y_disjoint == self.empty_label] = 0
+
+        # cur is already in DCIL insertion order (no sorting)
+        for j, cls_id in enumerate(cur, start=1):
+            y_cur_compact[y_disjoint == cls_id] = j
+
+        valid_cur_mask = (y_cur_compact != self.ignore_index)
+
+        y_seen_compact = np.full_like(y, fill_value=self.ignore_index)
+        y_seen_compact[is_empty] = 0
+
+        # seen is already in DCIL insertion order (no sorting)
+        for j, cls_id in enumerate(seen, start=1):
