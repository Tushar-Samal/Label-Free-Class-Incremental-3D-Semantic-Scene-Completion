+    def _get_render2d_mask_file(self, sequence, frame_id):
+        """
+        Expected layout:
+            render2d_mask_root/
+              00/
+                000000.png
+                000005.png
+
+        Also supports .npy:
+            render2d_mask_root/
+              00/
+                000000.npy
+        """
+        if (not self.render2d_enable) or (self.render2d_mask_root is None):
+            return None
+
+        seq = str(sequence).zfill(2)
+
+        png_path = osp.join(self.render2d_mask_root, seq, f"{frame_id}.png")
+        npy_path = osp.join(self.render2d_mask_root, seq, f"{frame_id}.npy")
+
+        if osp.exists(png_path):
+            return png_path
+
+        if osp.exists(npy_path):
+            return npy_path
+
+        return None
+
+    def _load_render2d_mask_raw(self, sequence, frame_id):
+        """
+        Loads open-vocabulary 2D mask before image augmentation.
+
+        Mask pixel values should already be student compact class ids:
+            1..8 = current new classes for your step 2
+            255  = ignore
+            0    = background / no supervision
+        """
+        mask_file = self._get_render2d_mask_file(sequence, frame_id)
+
+        if mask_file is None:
+            return None
+
+        if mask_file.endswith(".npy"):
+            mask = np.load(mask_file).astype(np.uint8)
+            return Image.fromarray(mask, mode="L")
+
+        return Image.open(mask_file).convert("L")
+
+    def _transform_render2d_mask(self, mask, resize_dims, crop, flip, rotate):
+        """
+        Same geometric augmentation as image/depth, but nearest-neighbor.
+        """
+        mask = mask.resize(resize_dims, resample=Image.NEAREST)
+        mask = mask.crop(crop)
+
+        if flip:
+            mask = mask.transpose(method=Image.FLIP_LEFT_RIGHT)
+
+        mask = mask.rotate(rotate, resample=Image.NEAREST)
+
+        return mask
