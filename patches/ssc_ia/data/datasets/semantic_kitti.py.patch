+    @staticmethod
+    def _splits_to_list(splits):
+        if splits is None:
+            return None
+
+        if isinstance(splits, (dict, DictConfig)):
+            keys = sorted(list(splits.keys()), key=lambda x: int(x))
+            return [list(splits[k]) for k in keys]
+
+        if isinstance(splits, (list, tuple, ListConfig)):
+            return [list(s) for s in splits]
+
+        raise TypeError(f"Unsupported continual_splits type: {type(splits)}")
+
+    @staticmethod
+    def _build_seen_new_classes(splits, step: int):
+        assert splits is not None
+        assert 0 <= step < len(splits), f"step={step} out of range for splits len={len(splits)}"
+        seen = _flatten_splits_preserve_order(splits, 0, step + 1)
+        new  = _unique_preserve_order(splits[step])
+        return seen, new
