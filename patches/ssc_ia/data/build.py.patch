+def _splits_to_list(splits):
+    """Allow continual_splits to be list-of-lists or dict {0:[...], 1:[...], ...}."""
+    if splits is None:
+        return None
+
+    if isinstance(splits, DictConfig):
+        splits = dict(splits)
+
+    if isinstance(splits, dict):
+        keys = sorted(list(splits.keys()), key=lambda x: int(x))
+        return [list(splits[k]) for k in keys]
+
+    if isinstance(splits, ListConfig):
+        splits = list(splits)
+
+    return [list(s) for s in splits]
+
+
+def unique_preserve_order(xs):
+    """Deduplicate while preserving first-seen insertion order."""
+    return list(dict.fromkeys(xs))
+
+
+def flatten_splits_preserve_order(splits, start, end):
+    """Concatenate splits[start:end] and deduplicate in insertion order."""
+    out = []
+    for i in range(start, end):
+        out.extend(list(splits[i]))
+    return unique_preserve_order(out)
+
+
+def _get_current_step_classes(continual_splits, continual_step: int):
+    splits = _splits_to_list(continual_splits)
+    assert splits is not None, "continual_splits is required for disjoint CIL"
+    assert 0 <= continual_step < len(splits), (
+        f"continual_step={continual_step} out of range (len={len(splits)})"
+    )
+    return unique_preserve_order(splits[continual_step])
+
+
+def _get_seen_step_classes(continual_splits, continual_step: int):
+    splits = _splits_to_list(continual_splits)
+    assert splits is not None, "continual_splits is required for disjoint CIL"
+    assert 0 <= continual_step < len(splits), (
+        f"continual_step={continual_step} out of range (len={len(splits)})"
+    )
+    return flatten_splits_preserve_order(splits, 0, continual_step + 1)
+
+
+def _get_base_new_old_novel_future(continual_splits, step: int):
+    """
+    Returns global-id class lists preserving DCIL insertion order (no sorting):
+      base   = S0
+      new    = Sk
+      old    = union S0..S{k-1}
+      novel  = S1..Sk
+      future = S{k+1}..S_last
+      seen   = S0..Sk
+    """
+    splits = _splits_to_list(continual_splits)
+    assert splits is not None, "continual_splits is required"
+    assert 0 <= step < len(splits), f"step={step} out of range (len={len(splits)})"
+
+    base = unique_preserve_order(splits[0])
+    new  = unique_preserve_order(splits[step])
+
+    old    = flatten_splits_preserve_order(splits, 0, step)          if step > 0              else []
+    novel  = flatten_splits_preserve_order(splits, 1, step + 1)      if step >= 1             else []
+    future = flatten_splits_preserve_order(splits, step + 1, len(splits)) if step < len(splits) - 1 else []
+    seen   = flatten_splits_preserve_order(splits, 0, step + 1)
+
+    return base, new, old, novel, future, seen
+
+
+def _get_cil_mode(dataset_cfg):
+    cil_mode = getattr(dataset_cfg, "cil_mode", None)
+    if cil_mode is None:
+        cil_mode = getattr(dataset_cfg, "cil_scenario", None)
+    return None if cil_mode is None else str(cil_mode).lower()
+
+
+def compute_disjoint_num_classes_and_weights(dataset_cfg, full_class_weights: torch.Tensor):
+    """
+    Seen-compact label space for pseudo-labeling:
+      0 = background
+      1..K = all seen classes up to current step
+    """
+    cil_mode = _get_cil_mode(dataset_cfg)
+    if cil_mode != "disjoint":
+        return int(full_class_weights.numel()), full_class_weights.float(), None, None
+
+    step = int(getattr(dataset_cfg, "continual_step", 0))
+    splits = _splits_to_list(getattr(dataset_cfg, "continual_splits", None))
+    assert splits is not None, "continual_splits is required for disjoint CIL"
+
+    cur  = unique_preserve_order(splits[step])
+    seen = flatten_splits_preserve_order(splits, 0, step + 1)
+
+    empty_label = int(getattr(dataset_cfg, "empty_label", 0))
+    num_classes = 1 + len(seen)
+
+    w_bg = full_class_weights[empty_label].view(1)
+    w_seen = full_class_weights[torch.tensor(seen, dtype=torch.long)]
+    cil_class_weights = torch.cat([w_bg, w_seen], dim=0).float()
+
+    assert cil_class_weights.numel() == num_classes, (
+        f"cil_class_weights has {cil_class_weights.numel()} but num_classes={num_classes}"
+    )
+
+    return num_classes, cil_class_weights, cur, seen
+
