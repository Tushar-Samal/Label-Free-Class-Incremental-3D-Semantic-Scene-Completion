+def _get_voxel_target(target):
+    """
+    DISC expects voxel GT either as:
+      - dict with key 'target' (torch tensor or numpy array)
+      - raw numpy array / torch tensor (L, W, H)
+    Returns voxel_data as a torch.Tensor (L, W, H).
+    """
+    if isinstance(target, dict):
+        voxel = target.get("target", None)
+        if voxel is None:
+            raise KeyError(
+                f"target dict has no 'target' key. Available keys: {list(target.keys())}"
+            )
+    else:
+        voxel = target
+
+    if isinstance(voxel, np.ndarray):
+        voxel = torch.from_numpy(voxel)
+    elif not torch.is_tensor(voxel):
+        raise TypeError(f"Unsupported voxel target type: {type(voxel)}")
+    return voxel.long()
+
+
+def _get_ignore_index(target, default=255):
+    if isinstance(target, dict):
+        if "ignore_index" in target:
+            return int(target["ignore_index"])
+        if "ignore_label" in target:
+            return int(target["ignore_label"])
+    return int(default)
+
+
+def _get_empty_label(target, default=0):
+    if isinstance(target, dict) and "empty_label" in target:
+        return int(target["empty_label"])
+    return int(default)
+
+
+def _get_voxel_target_for_projection(target):
+    """
+    For projection/aux GT generation, prefer compact target when available.
+    - If disjoint CIL: use target_compact (compact label space)
+    - Else: use target (global label space)
+    """
+    if isinstance(target, dict) and ("target_compact" in target):
+        voxel = target["target_compact"]
+        if isinstance(voxel, np.ndarray):
+            voxel = torch.from_numpy(voxel)
+        elif not torch.is_tensor(voxel):
+            raise TypeError(f"Unsupported target_compact type: {type(voxel)}")
+        return voxel.long()
+    return _get_voxel_target(target)
+
+
+def _get_step_indices(target, mode: str):
+    """
+    Returns indices for 'bk' or 'ins'.
+    - If disjoint CIL compact indices exist: use them (cil_*_indices)
+    - Else: use global indices from bk_cls_info / ins_cls_info
+    """
+    assert mode in ("bk", "ins")
+
+    key = "cil_bk_indices" if mode == "bk" else "cil_ins_indices"
+    if isinstance(target, dict) and (key in target):
+        idx = target[key]
+        if torch.is_tensor(idx):
+            idx = idx.squeeze(0).detach().cpu().numpy()
+        else:
+            idx = np.asarray(idx).squeeze(0)
+        return idx.astype(np.int64)
+
+    if mode == "bk":
+        idx = target["bk_cls_info"]["indices"][1:]
+    else:
+        idx = target["ins_cls_info"]["indices"][1:]
+
+    if torch.is_tensor(idx):
+        idx = idx.detach().cpu().numpy()
+    return np.asarray(idx, dtype=np.int64)
+
