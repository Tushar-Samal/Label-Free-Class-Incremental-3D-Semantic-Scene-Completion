 import torch
 import torch.nn.functional as F
 
+def _get_cil_target(target, ignore_index: int = 255):
+    """
+    Returns (y, ignore_index) for loss computation.
+    - If disjoint CIL is enabled in dataset, use 'target_compact'
+    - else fallback to 'target'
+    """
+    if 'target_compact' in target:
+        return target['target_compact'], ignore_index
+    return target['target'], ignore_index
+
+def _get_cil_class_weights(target, num_classes: int):
+    """
+    Returns class weights compatible with current logits channels.
+    - If disjoint CIL: use 'cil_class_weights' if provided, else None
+    - Else: use full 'class_weights'
+    """
+    if 'target_compact' in target:
+        # best practice: pass cil_class_weights from dataloader/model
+        w = target.get('cil_class_weights', None)
+        if w is None:
+            return None
+        w = w.float()
+        assert len(w) == num_classes, f"cil_class_weights len {len(w)} != num_classes {num_classes}"
+        return w
+    else:
+        w = target.get('class_weights', None)
+        if w is None:
+            return None
+        w = w.float()
+        assert len(w) == num_classes, f"class_weights len {len(w)} != num_classes {num_classes}"
+        return w
 
