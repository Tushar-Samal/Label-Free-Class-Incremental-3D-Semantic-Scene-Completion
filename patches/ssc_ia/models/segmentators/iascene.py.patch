+def _splits_to_list(splits):
+    """Allow dict {0:[...],1:[...]} / DictConfig / list-of-lists."""
+    if splits is None:
+        return None
+    if OmegaConf.is_config(splits) or isinstance(splits, dict):
+        keys = sorted(list(splits.keys()), key=lambda x: int(x))
+        return [list(splits[k]) for k in keys]
+    return [list(s) for s in splits]
+
+
+def _get_cur_classes(continual_splits, continual_step: int):
+    splits = _splits_to_list(continual_splits)
+    if splits is None:
+        return None
+    if not (0 <= continual_step < len(splits)):
+        raise ValueError(f"continual_step={continual_step} out of range for splits len={len(splits)}")
+    return sorted(set(list(splits[continual_step])))
+
+
+def _get_seen_classes(continual_splits, continual_step: int):
+    splits = _splits_to_list(continual_splits)
+    if splits is None:
+        return None
+    if not (0 <= continual_step < len(splits)):
+        raise ValueError(f"continual_step={continual_step} out of range for splits len={len(splits)}")
+    seen = []
+    for s in range(continual_step + 1):
+        seen.extend(list(splits[s]))
+    return sorted(set(seen))
 
