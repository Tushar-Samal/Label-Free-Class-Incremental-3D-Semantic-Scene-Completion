+        # in restore_optimizers() / restore_lr_schedulers() iterate 0 times.
+        checkpoint["optimizer_states"] = []
+        checkpoint["lr_schedulers"] = []
+
+        # Remove loop-progress so restore_loops() skips epoch restoration
+        # and training starts from epoch 0.
+        checkpoint.pop("loops", None)
+
+        # Remove callback states (notably ModelCheckpoint's best_model_score)
+        # so this step's "best" tracking starts fresh instead of inheriting
+        # the previous step's score, which is on an unrelated class set and
+        # would otherwise permanently block this step from ever saving a
+        # new best checkpoint. checkpoint.get("callbacks") returning None
+        # makes Lightning's _call_callbacks_load_state_dict skip restoration
