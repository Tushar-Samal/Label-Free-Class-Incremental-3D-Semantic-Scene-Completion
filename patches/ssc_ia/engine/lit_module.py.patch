+        If mismatches are found, neutralises optimizer / scheduler / epoch
+        restoration so Step k starts a fresh training run from epoch 0.
+
+        For within-step resume (no shape mismatches) this is a no-op.
+
+        NOTE: optimizer_states and lr_schedulers must be *emptied*, not
+        *removed* — Lightning raises KeyError if those keys are absent
+        (checkpoint_connector.py lines 361-372).
+        """
+        state_dict = checkpoint.get("state_dict", {})
+        model_state = self.state_dict()
+
+        mismatched = [
+            k for k, v in state_dict.items()
+            if k in model_state
+            and tuple(v.shape) != tuple(model_state[k].shape)
+        ]
+
+        if not mismatched:
+            return  # within-step resume — do nothing
+
+        print(
+            f"\n[CIL CKPT] Cross-step load detected "
+            f"(continual_step={self.continual_step}). "
+            f"{len(mismatched)} shape-mismatched key(s) will be "
+            f"expanded (old channels copied, new channels random-init):"
+        )
+        for k in mismatched:
+            print(
+                f"  EXPAND  {k}:  "
+                f"ckpt={tuple(state_dict[k].shape)}  "
+                f"->  model={tuple(model_state[k].shape)}"
