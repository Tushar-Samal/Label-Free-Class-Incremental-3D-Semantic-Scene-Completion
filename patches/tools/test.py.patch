+def expand_teacher_compact_to_global(logits_compact, old_global_classes, empty_label=0):
+    """
+    Teacher is step-0 old-class model:
+      compact channel 0 = background
+      compact channel 1..K = old_global_classes in sorted order
 
-@hydra.main(config_path='../configs', config_name='my_config_sema', version_base=None)
+    logits_compact: [B, Cc, L, W, H]
+    returns logits_global: [B, 20, L, W, H]
+    """
+    B, Cc, L, W, H = logits_compact.shape
+    num_global = 20
+
+    logits_global = torch.zeros(
+        B, num_global, L, W, H,
+        device=logits_compact.device,
+        dtype=logits_compact.dtype
+    )
+
+    logits_global[:, empty_label] = logits_compact[:, 0]
+
+    old_sorted = sorted(list(old_global_classes))
+    expected = 1 + len(old_sorted)
+    if Cc != expected:
+        raise ValueError(
+            f"Teacher compact logits have C={Cc}, expected {expected} "
+            f"(bg + {len(old_sorted)} old classes)"
+        )
+
+    for j, g in enumerate(old_sorted, start=1):
+        logits_global[:, g] = logits_compact[:, j]
+
+    return logits_global
