+def to_cpu_recursive(x):
+    if torch.is_tensor(x):
+        return x.detach().cpu()
+    if isinstance(x, dict):
+        return {k: to_cpu_recursive(v) for k, v in x.items()}
+    if isinstance(x, (list, tuple)):
+        t = [to_cpu_recursive(v) for v in x]
+        return type(x)(t) if isinstance(x, tuple) else t
+    return x
+
+
+def compact_pred_to_global(pred_compact, meta_info):
+    """
+    pred_compact: numpy array [L, W, H] with compact seen-space ids
+    returns:     numpy array [L, W, H] with global SemanticKITTI ids
+    """
+    pred_global = np.zeros_like(pred_compact, dtype=np.int32)
+
+    seen = meta_info.get("seen_global_classes", None)
+    if seen is None:
+        raise ValueError("meta_info['seen_global_classes'] is missing")
+
+    for compact_id, global_id in enumerate(seen, start=1):
+        pred_global[pred_compact == compact_id] = global_id
+
+    return pred_global
+
